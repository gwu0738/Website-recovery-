[Unit]
Description=Vanta casino backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vanta
Group=vanta
WorkingDirectory=/opt/vanta/app
EnvironmentFile=/opt/vanta/vanta.env
ExecStart=/usr/bin/node server/server.ts
Restart=always
RestartSec=3
# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/vanta/data

[Install]
WantedBy=multi-user.target
